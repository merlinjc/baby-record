.hero-card--baby-edit {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, #fff8ed, #f3e7d8 56%, #ecccac 100%);
}

.hero-backdrop--edit {
  position: absolute;
  top: -40rpx;
  right: -16rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0));
}

.setup-card {
  background: linear-gradient(180deg, #fffdf9, #fff3e4);
}

.field-group {
  display: block;
}
