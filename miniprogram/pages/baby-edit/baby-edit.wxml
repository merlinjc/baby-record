<view class="page">
  <ui-hero
    extra-class="hero-card--baby-edit"
    chip="创建档案"
    accent="SETUP"
    kicker="先用最少字段完成建档，把用户尽快带入上传和时间轴闭环。"
    title="创建宝宝档案"
    subtitle="P0 仅要求姓名、生日、性别三项，后续更多资料可以再扩展。"
  ></ui-hero>

  <view class="form-card mt-24 setup-card">
    <section-header title="基础信息" caption="只填最少字段，先把记录流程跑通" chip="P0"></section-header>

    <form-field icon-name="baby" label="宝宝姓名" extra-class="mb-32">
      <input class="text-input" placeholder="例如：小满" maxlength="20" value="{{name}}" bindinput="onNameInput" />
    </form-field>

    <form-field icon-name="clock-3" label="出生日期" extra-class="mb-32">
      <picker mode="date" value="{{birthday}}" end="2099-12-31" bindchange="onBirthdayChange">
        <view class="picker-field">{{birthday}}</view>
      </picker>
    </form-field>

    <form-field icon-name="user-round-check" label="性别">
      <picker mode="selector" range="{{genderOptions}}" value="{{genderValue}}" bindchange="onGenderChange">
        <view class="picker-field">{{genderOptions[genderValue]}}</view>
      </picker>
    </form-field>

    <info-pill-list extra-class="mt-24" items="{{['生日用于年龄计算', '当前档案会决定上传归属']}}"></info-pill-list>
  </view>

  <button class="btn-primary mt-32" loading="{{isSaving}}" bindtap="saveBaby">保存并进入首页</button>
</view>
