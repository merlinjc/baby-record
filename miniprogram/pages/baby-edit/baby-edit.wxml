<view class="page">
  <view class="hero-card hero-card--baby-edit">
    <view class="hero-backdrop hero-backdrop--edit"></view>
    <view class="hero-topline">
      <view class="chip">创建档案</view>
      <view class="hero-accent">SETUP</view>
    </view>
    <view class="page-title mt-24">创建宝宝档案</view>
    <view class="page-subtitle mt-16">P0 仅要求姓名、生日、性别三项，尽快进入上传流程。</view>
  </view>

  <view class="form-card mt-24 setup-card">
    <view class="section-header mb-32">
      <view>
        <view class="section-title">基础信息</view>
        <view class="section-caption mt-16">只填最少字段，先把记录流程跑通</view>
      </view>
      <view class="chip">P0</view>
    </view>

    <view class="field-group mb-32">
      <text class="field-label">宝宝姓名</text>
      <input class="text-input" placeholder="例如：小满" maxlength="20" value="{{name}}" bindinput="onNameInput" />
    </view>

    <view class="field-group mb-32">
      <text class="field-label">出生日期</text>
      <picker mode="date" value="{{birthday}}" end="2099-12-31" bindchange="onBirthdayChange">
        <view class="picker-field">{{birthday}}</view>
      </picker>
    </view>

    <view class="field-group">
      <text class="field-label">性别</text>
      <picker mode="selector" range="{{genderOptions}}" value="{{genderValue}}" bindchange="onGenderChange">
        <view class="picker-field">{{genderOptions[genderValue]}}</view>
      </picker>
    </view>
  </view>

  <button class="btn-primary mt-32" loading="{{isSaving}}" bindtap="saveBaby">保存并进入首页</button>
</view>
