<view class="page">
  <ui-hero
    extra-class="hero-card--browse"
    chip="照片流"
    accent="BROWSE"
    kicker="持续浏览和快速筛选分开处理，优先保证可读性和滚动效率。"
    title="连续浏览成长记录"
    subtitle="{{currentBaby ? currentBaby.name + ' 的照片按时间倒序分页加载，可结合地点筛选快速定位。' : '先创建档案，再进入照片流浏览成长记录。'}}"
  >
    <view wx:if="{{!isLoading && currentBaby}}" class="summary-grid mt-24">
      <summary-stat value="{{photos.length}}" label="当前已加载"></summary-stat>
      <summary-stat value="{{total}}" label="全部照片"></summary-stat>
    </view>
  </ui-hero>

  <block wx:if="{{isLoading}}">
    <status-card extra-class="mt-24" loading="{{true}}" title="正在整理照片流" desc="按时间倒序读取照片，准备瀑布流展示。"></status-card>
  </block>

  <block wx:elif="{{loadError}}">
    <status-card extra-class="mt-24" title="照片流暂时不可用" desc="{{loadError}}">
      <view class="status-card__actions">
        <button class="btn-secondary" bindtap="retryLoad">重新加载</button>
      </view>
    </status-card>
  </block>

  <block wx:elif="{{!currentBaby}}">
    <empty-state-panel extra-class="mt-24" icon-name="badge-plus" title="先创建一个宝宝档案" desc="照片流依赖当前档案，创建后可持续按分页浏览所有照片。">
      <button class="btn-primary mt-24" bindtap="goCreateBaby">创建档案</button>
    </empty-state-panel>
  </block>

  <block wx:elif="{{photos.length}}">
    <view class="section-card mt-24 browse-note-card">
      <section-header title="浏览方式" caption="{{activeLocation ? '当前按地点筛选展示，地点：' + activeLocation : '滚动到底部会继续按页加载，每页 ' + pageSize + ' 张'}}" chip="倒序浏览"></section-header>
    </view>

    <view wx:if="{{locationOptions.length}}" class="filter-shell mt-24">
      <section-header title="地点筛选" caption="支持按手动标注的地点快速筛选照片" chip="Location"></section-header>
      <scroll-view scroll-x class="location-filter-scroll mt-24">
        <view class="location-filter-row">
          <view class="location-chip {{!activeLocation ? 'location-chip--active' : ''}}" data-value="" bindtap="changeLocation">全部</view>
          <view wx:for="{{locationOptions}}" wx:key="name" class="location-chip {{activeLocation === item.name ? 'location-chip--active' : ''}}" data-value="{{item.name}}" bindtap="changeLocation">{{item.name}} · {{item.count}}</view>
        </view>
      </scroll-view>
    </view>

    <view class="waterfall-grid mt-24">
      <view class="waterfall-column" wx:for="{{waterfallColumns}}" wx:key="*this">
        <photo-entry-card wx:for="{{item}}" wx:key="_id" photo="{{item}}" bind:tap="openPhotoDetail"></photo-entry-card>
      </view>
    </view>

    <status-card wx:if="{{isLoadingMore}}" extra-class="mt-24" loading="{{true}}" title="正在加载更多照片" desc="继续下滑可逐页浏览。"></status-card>

    <status-card wx:elif="{{!hasMore}}" extra-class="mt-24" compact="{{true}}" title="已经到底了" desc="全部 {{total}} 张照片都已展示。"></status-card>
  </block>

  <block wx:else>
    <empty-state-panel extra-class="mt-24" icon-name="images" title="还没有照片" desc="先上传第一批成长照片，照片流会按时间倒序持续加载。">
      <button class="btn-primary mt-24" bindtap="goUpload">去上传照片</button>
    </empty-state-panel>
  </block>
</view>
