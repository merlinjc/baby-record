.hero-card--baby-profile {
  background: linear-gradient(145deg, #fff8ed, #f5e5d6 56%, #e8c8a9 100%);
}

.baby-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.baby-card {
  background: linear-gradient(180deg, rgba(255, 253, 249, 0.97), rgba(255, 243, 229, 0.98));
  border: 2rpx solid rgba(229, 205, 178, 0.45);
  padding: 28rpx;
}

.baby-card__meta {
  flex: 1;
}

.baby-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.baby-card__name {
  font-size: 34rpx;
  font-weight: 700;
}

.baby-card__detail {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.baby-card__summary {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.baby-card__summary-item {
  flex: 1;
  min-width: 220rpx;
}

.baby-card__button {
  width: 100%;
}

.baby-card__button--disabled {
  opacity: 0.9;
}
