<view class="page">
  <block wx:if="{{isLoading}}">
    <status-card loading="{{true}}" title="正在打开照片详情" desc="正在读取照片和拍摄日期信息。"></status-card>
  </block>

  <block wx:elif="{{loadError}}">
    <status-card title="照片详情暂时不可用" desc="{{loadError}}">
      <view class="status-card__actions">
        <button class="btn-secondary" bindtap="retryLoad">重新加载</button>
      </view>
    </status-card>
  </block>

  <block wx:elif="{{photo}}">
    <ui-hero
      extra-class="hero-card--detail"
      chip="照片详情"
      accent="DETAIL"
      kicker="图片预览、元信息和风险动作分区展示，避免详情页只剩一张大图。"
      title="{{dateLabel}}"
      subtitle="点击图片可全屏预览，下载和删除动作放在底部操作区。"
    >
      <image class="detail-image mt-24" src="{{photo.filePath}}" mode="widthFix" bindtap="previewPhoto"></image>
      <view class="detail-panel mt-24">
        <section-header title="照片信息" caption="记录描述、地点和可见权限" chip="{{photo.permission === 'private' ? '私密' : photo.permission === 'admin' ? '管理可见' : '家庭可见'}}"></section-header>
        <view class="detail-desc mt-24">{{photo.description || '这张照片还没有描述。'}}</view>
        <view class="detail-meta-list mt-24">
          <metric-info-card icon-name="clock-3" label="拍摄日期" value="{{photo.photoDate}}" extra-class="detail-meta-card"></metric-info-card>
          <metric-info-card icon-name="map-pinned" label="地点" value="{{photo.locationName || '未标记地点'}}" extra-class="detail-meta-card"></metric-info-card>
        </view>
        <view class="info-band mt-24">点击图片可全屏预览</view>
      </view>
      <view class="detail-actions mt-24">
        <action-card icon-name="download" extra-class="detail-actions__item" title="下载照片" desc="支持保存原图或压缩图到系统相册" bind:tap="saveToAlbum"></action-card>
        <action-card wx:if="{{photo.canManage}}" icon-name="trash-2" extra-class="detail-actions__item detail-actions__item--danger" title="移入回收站" desc="照片会先进入回收站，后续仍可恢复" bind:tap="deletePhoto"></action-card>
      </view>
    </ui-hero>
  </block>
  <block wx:else>
    <empty-state-panel extra-class="mt-24" icon-name="images" title="照片不存在" desc="可能已被删除，或者页面参数无效。">
      <view class="status-inline">请返回列表重新选择</view>
    </empty-state-panel>
  </block>
</view>
