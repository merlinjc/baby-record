<view class="page">
  <block wx:if="{{isLoading}}">
    <view class="section-card status-card">
      <view class="loading-dots">
        <view class="loading-dots__item"></view>
        <view class="loading-dots__item"></view>
        <view class="loading-dots__item"></view>
      </view>
      <view class="status-card__title">正在打开照片详情</view>
      <view class="status-card__desc">正在读取照片和拍摄日期信息。</view>
    </view>
  </block>

  <block wx:elif="{{loadError}}">
    <view class="section-card status-card">
      <view class="status-card__title">照片详情暂时不可用</view>
      <view class="status-card__desc">{{loadError}}</view>
      <view class="status-card__actions">
        <button class="btn-secondary" bindtap="retryLoad">重新加载</button>
      </view>
    </view>
  </block>

  <block wx:elif="{{photo}}">
    <view class="hero-card hero-card--detail">
      <view class="hero-topline detail-topline">
        <view class="chip">照片详情</view>
        <view class="hero-accent">DETAIL</view>
      </view>
      <image class="detail-image mt-24" src="{{photo.filePath}}" mode="widthFix" bindtap="previewPhoto"></image>
      <view class="detail-panel mt-24">
        <view class="detail-date">{{dateLabel}}</view>
        <view class="detail-desc mt-16">{{photo.description || '这张照片还没有描述。'}}</view>
        <view wx:if="{{photo.locationName}}" class="detail-meta mt-16">地点：{{photo.locationName}}</view>
        <view wx:if="{{photo.permission}}" class="detail-meta mt-16">权限：{{photo.permission === 'private' ? '仅上传者可见' : photo.permission === 'admin' ? '仅创建者/管理员可见' : '家庭成员可见'}}</view>
        <view class="status-inline">点击图片可全屏预览</view>
      </view>
      <view class="detail-actions mt-24">
        <button class="btn-secondary detail-actions__item" loading="{{saving}}" bindtap="saveToAlbum">下载照片</button>
        <button wx:if="{{photo.canManage}}" class="btn-danger detail-actions__item" loading="{{deleting}}" bindtap="deletePhoto">移入回收站</button>
      </view>
    </view>
  </block>
  <block wx:else>
    <view class="section-card empty-state">
      <view class="empty-state__title">照片不存在</view>
      <view class="empty-state__desc">可能已被删除，或者页面参数无效。</view>
      <view class="status-inline">请返回列表重新选择</view>
    </view>
  </block>
</view>
