.hero-card--detail {
  background: linear-gradient(145deg, #fff8ef, #f4e3d6 56%, #e9c5a7 100%);
}

.detail-topline {
  align-items: flex-start;
}

.detail-image {
  width: 100%;
  border-radius: 20rpx;
  display: block;
  background: #f4e8d5;
  box-shadow: 0 12rpx 28rpx rgba(139, 69, 19, 0.14);
}

.detail-panel {
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fffaf3, #fff4e8);
  border: 2rpx solid rgba(232, 209, 184, 0.5);
}

.detail-meta-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.detail-meta-card {
  min-width: 220rpx;
}

.detail-desc {
  font-size: 30rpx;
  line-height: 1.6;
}

.detail-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.detail-actions__item {
  flex: 1;
}

.detail-actions__item--danger {
  background: linear-gradient(180deg, rgba(254, 240, 236, 0.96), rgba(250, 223, 217, 0.98));
  border-color: rgba(228, 144, 128, 0.34);
}

.detail-actions__item--danger .action-card__title {
  color: #a63d2f;
}

.detail-actions__item--danger .action-card__desc {
  color: #b26a5f;
}
