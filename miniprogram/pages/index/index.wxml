<view class="page">
  <ui-hero
    extra-class="hero-card--home"
    chip="成长首页"
    accent="HOME"
    kicker="保留温暖、简洁、易用的设计原则，把最短记录闭环放在第一屏。"
    title="把宝宝的重要瞬间，整理成一条可持续回看的成长线"
    subtitle="首页聚焦当前档案、上传入口、最近记录和照片流预览，减少来回跳转。"
  >
    <view class="hero-actions mt-32">
      <button class="btn-primary hero-action hero-action--primary" bindtap="goUpload">上传照片</button>
      <button class="btn-secondary hero-action" bindtap="goTimeline">查看时间轴</button>
    </view>
  </ui-hero>

  <block wx:if="{{isLoading}}">
    <status-card extra-class="mt-24" loading="{{true}}" title="正在整理成长记录" desc="正在获取宝宝档案、时间轴统计和最新照片。"></status-card>
  </block>

  <block wx:elif="{{loadError}}">
    <status-card extra-class="mt-24" title="暂时没能打开首页" desc="{{loadError}}">
      <view class="status-card__actions">
        <button class="btn-secondary" bindtap="retryLoad">重新加载</button>
      </view>
    </status-card>
  </block>

  <block wx:elif="{{hasBaby}}">
    <view class="summary-card mt-24 dashboard-card">
      <section-header title="当前档案概览" caption="上传、浏览和时间轴都围绕当前宝宝档案展开" chip="{{currentBaby.name}}"></section-header>

      <view class="baby-overview home-baby-overview mt-24">
        <view class="baby-overview__main">
          <view class="baby-overview__name">{{currentBaby.name}}</view>
          <view class="text-muted mt-16">{{ageLabel}} · {{currentBaby.birthday}}</view>
        </view>
        <view class="baby-overview__badge">当前档案</view>
      </view>

      <view class="summary-grid mt-24">
        <summary-stat value="{{photoCount}}" label="累计照片"></summary-stat>
        <summary-stat value="{{latestDateLabel || '--'}}" label="最近记录"></summary-stat>
        <summary-stat value="{{monthCount || 0}}" label="归档月份"></summary-stat>
      </view>

      <view wx:if="{{photoCount}}" class="info-band mt-24">最近一次上传后，可直接进入时间轴按月份回看</view>

      <view class="action-grid mt-24">
        <action-card icon-name="baby" title="切换档案" desc="管理档案并设置当前使用中的宝宝" bind:tap="goBabyProfiles"></action-card>
        <action-card icon-name="images" title="浏览照片流" desc="按时间倒序快速翻看最近记录" bind:tap="goPhotoBrowse"></action-card>
        <action-card icon-name="circle-user-round" title="进入我的" desc="查看统计、家庭成员和回收站入口" bind:tap="goProfile"></action-card>
      </view>
    </view>

    <view class="section-card mt-24 feed-card">
      <section-header title="照片浏览预览" caption="首页仅展示最新 6 张，保证信息密度和可读性平衡" chip="{{photoCount}} 张"></section-header>

      <block wx:if="{{photos.length}}">
        <view class="waterfall-grid mt-24">
          <view class="waterfall-column" wx:for="{{waterfallColumns}}" wx:key="*this">
            <photo-entry-card wx:for="{{item}}" wx:key="_id" photo="{{item}}" bind:tap="openPhotoDetail"></photo-entry-card>
          </view>
        </view>

        <view class="inline-actions mt-24">
          <button class="btn-secondary hero-action" bindtap="goPhotoBrowse">进入照片流</button>
          <button class="btn-ghost hero-action" bindtap="goTimeline">按时间回看</button>
        </view>
      </block>

      <block wx:else>
        <empty-state-panel title="还没有照片" icon-name="images" desc="先上传第一批成长照片，首页会按时间倒序展示最近记录。" extra-class="panel-plain">
          <button class="btn-primary" bindtap="goUpload">上传第一张</button>
        </empty-state-panel>
      </block>
    </view>
  </block>

  <block wx:else>
    <empty-state-panel extra-class="mt-24" icon-name="badge-plus" title="先创建一个宝宝档案" desc="当前 MVP 先服务单宝宝记录，建档后即可开始上传照片、生成时间轴和浏览照片流。">
      <view class="status-inline">先建档，再开始记录</view>
      <button class="btn-primary mt-24" bindtap="goCreateBaby">创建档案</button>
    </empty-state-panel>
  </block>
</view>
