.hero-card--home {
  background: linear-gradient(145deg, #fff7ed, #f6e4cf 56%, #ebc79f 100%);
}

.home-baby-overview {
  padding: 26rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, rgba(255, 250, 243, 0.96), rgba(255, 244, 230, 0.92));
  border: 2rpx solid rgba(230, 205, 176, 0.5);
}

.baby-overview__name {
  font-size: 40rpx;
  font-weight: 700;
}

.baby-overview__main {
  flex: 1;
}

.baby-overview__badge {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f8ead7;
  color: #8b4513;
  font-size: 22rpx;
}
