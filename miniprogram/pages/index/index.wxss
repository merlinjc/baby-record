.hero-card--home {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, #fff8ee, #f7e7d1 55%, #f0d4b4 100%);
  box-shadow: 0 18rpx 44rpx rgba(139, 69, 19, 0.16);
}

.hero-backdrop {
  position: absolute;
  top: -64rpx;
  right: -40rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0));
}

.hero-action {
  flex: 1;
}

.hero-action--primary {
  box-shadow: 0 10rpx 20rpx rgba(139, 69, 19, 0.16);
}

.baby-overview__name {
  font-size: 38rpx;
  font-weight: 700;
}

.baby-overview__main {
  flex: 1;
}

.baby-overview__badge {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f8ead7;
  color: #8b4513;
  font-size: 22rpx;
}

.dashboard-card,
.feed-card,
.onboarding-card {
  background: linear-gradient(180deg, #fffdf9, #fff7ec);
}

.waterfall-grid {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.photo-card {
  background: linear-gradient(180deg, #ffffff, #fffaf3);
  box-shadow: 0 10rpx 24rpx rgba(139, 69, 19, 0.08);
  overflow: hidden;
  border-radius: 24rpx;
}

.photo-card__image {
  width: 100%;
  display: block;
  background: #f3e5d0;
}

.photo-card__body {
  padding: 18rpx 20rpx 22rpx;
}

.photo-card__date {
  font-size: 22rpx;
  color: #8d6e63;
}

.photo-card__desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #3e2723;
}

.photo-card__hint {
  margin-top: 14rpx;
  font-size: 20rpx;
  color: #b0835f;
}
