.hero-card--upload {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, #fff8ed, #f4eadc 55%, #ecd2ba 100%);
}

.hero-backdrop--upload {
  position: absolute;
  top: -44rpx;
  right: -18rpx;
  width: 228rpx;
  height: 228rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0));
}

.upload-form-card {
  background: linear-gradient(180deg, #fffdf9, #fff3e4);
}

.current-baby-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fffaf3;
}

.current-baby-panel__label {
  font-size: 22rpx;
  color: #9d7d67;
}

.current-baby-panel__name {
  font-size: 34rpx;
  font-weight: 700;
}

.upload-progress-card {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fffaf3;
}

.upload-progress-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.upload-progress-card__value {
  font-size: 32rpx;
  font-weight: 700;
  color: #8b4513;
}

.upload-progress-bar {
  width: 100%;
  height: 14rpx;
  border-radius: 999rpx;
  background: #f0dfc8;
  overflow: hidden;
}

.upload-progress-bar__fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #8b4513, #d2691e);
}

.upload-tip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.upload-tip {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #fff7ea;
  color: #8b5e34;
  font-size: 22rpx;
}

.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.upload-item,
.upload-picker {
  width: calc(33.33% - 14rpx);
  height: 200rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 10rpx 20rpx rgba(139, 69, 19, 0.08);
}

.upload-item__image {
  width: 100%;
  height: 100%;
  display: block;
}

.upload-item__remove {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  background: rgba(62, 39, 35, 0.78);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 20rpx;
  padding: 8rpx 16rpx;
}

.upload-picker {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #fffdf9, #fff3e4);
  border: 2rpx dashed #d7b48a;
  color: #8b4513;
}

.upload-picker__plus {
  font-size: 52rpx;
  line-height: 1;
}

.upload-picker__text {
  margin-top: 12rpx;
  font-size: 22rpx;
}
