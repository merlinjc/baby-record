<view class="page">
  <ui-hero
    extra-class="hero-card--upload"
    chip="上传照片"
    accent="UPLOAD"
    kicker="把表单信息、进度反馈和已选图片放进一张主卡片里，减少操作断层。"
    title="把今天的瞬间收入档案"
    subtitle="当前档案：{{currentBaby ? currentBaby.name : '未创建宝宝档案'}}。支持一次最多 9 张照片，拍摄日期会直接进入时间轴归档。"
  ></ui-hero>

  <block wx:if="{{isLoading}}">
    <status-card extra-class="mt-24" loading="{{true}}" title="正在准备上传环境" desc="确认当前宝宝档案和上传上下文。"></status-card>
  </block>

  <block wx:elif="{{loadError}}">
    <status-card extra-class="mt-24" title="上传页暂时不可用" desc="{{loadError}}">
      <view class="status-card__actions">
        <button class="btn-secondary" bindtap="retryLoad">重新加载</button>
      </view>
    </status-card>
  </block>

  <block wx:elif="{{!currentBaby}}">
    <empty-state-panel extra-class="mt-24" icon-name="badge-plus" title="先创建一个宝宝档案" desc="上传功能依赖当前档案，创建后才能把照片写入云端并进入时间轴。">
      <view class="status-inline">先完成档案创建，再回来上传</view>
      <button class="btn-primary mt-24" bindtap="goCreateBaby">创建档案</button>
    </empty-state-panel>
  </block>

  <block wx:elif="{{!canUpload}}">
    <empty-state-panel extra-class="mt-24" icon-name="shield-check" title="当前角色不能上传照片" desc="仅创建者、管理员和普通成员可上传。你当前是 {{currentRole || '无权限成员'}}。">
      <view class="status-inline">可联系创建者调整角色</view>
    </empty-state-panel>
  </block>

  <block wx:else>
    <view class="form-card mt-24 upload-form-card">
      <section-header title="上传设置" caption="本次描述会应用到当前选择的全部照片" chip="{{selectedFiles.length}} / 9"></section-header>

      <view class="current-baby-panel mb-32">
        <view>
          <view class="current-baby-panel__label">当前档案</view>
          <view class="current-baby-panel__name mt-16">{{currentBaby.name}}</view>
        </view>
        <view class="pill">{{currentBaby.birthday}}</view>
      </view>

      <view wx:if="{{uploading || uploadProgress}}" class="upload-progress-card mb-32">
        <view class="upload-progress-card__header">
          <view class="section-title">上传进度</view>
          <view class="upload-progress-card__value">{{uploadProgress}}%</view>
        </view>
        <view class="upload-progress-bar mt-16">
          <view class="upload-progress-bar__fill" style="width: {{uploadProgress}}%;"></view>
        </view>
        <view class="section-caption mt-16">{{uploadProgressText || '等待开始'}}</view>
      </view>

      <form-field icon-name="clock-3" label="拍摄日期" extra-class="mb-32">
        <picker mode="date" value="{{photoDate}}" end="2099-12-31" bindchange="onDateChange">
          <view class="picker-field">{{photoDate}}</view>
        </picker>
      </form-field>

      <form-field icon-name="shield-check" label="可见范围" extra-class="mb-32">
        <picker mode="selector" range="{{permissionOptions}}" range-key="label" value="{{permissionValue}}" bindchange="onPermissionChange">
          <view class="picker-field">{{permissionOptions[permissionValue].label}}</view>
        </picker>
      </form-field>

      <form-field icon-name="map-pinned" label="地点标记" extra-class="mb-32">
        <input class="text-input" placeholder="例如：客厅、朝阳公园" maxlength="30" value="{{locationName}}" bindinput="onLocationInput" />
      </form-field>

      <form-field icon-name="text" label="照片描述" extra-class="mb-32">
        <textarea class="text-area" maxlength="140" placeholder="例如：第一次自己扶着沙发站起来" value="{{description}}" bindinput="onDescInput"></textarea>
      </form-field>

      <info-pill-list extra-class="mb-32" items="{{['照片会自动上传到 CloudBase 云存储', '拍摄日期决定时间轴月份分组']}}"></info-pill-list>

      <form-field icon-name="images" label="已选照片（{{selectedFiles.length}}/9）">
        <view class="upload-grid mt-16">
          <view class="upload-item" wx:for="{{selectedFiles}}" wx:key="*this">
            <image class="upload-item__image" src="{{item}}" mode="aspectFill"></image>
            <view class="upload-item__remove" data-index="{{index}}" bindtap="removeImage">移除</view>
          </view>
          <view wx:if="{{selectedFiles.length < 9 && !uploading}}" class="upload-picker" bindtap="chooseImages">
            <view class="upload-picker__plus">+</view>
            <view class="upload-picker__text">添加照片</view>
          </view>
        </view>
      </form-field>
    </view>

    <button class="btn-primary mt-32" loading="{{uploading}}" bindtap="submitUpload">确认上传 {{selectedFiles.length ? '(' + selectedFiles.length + ')' : ''}}</button>
  </block>
</view>
