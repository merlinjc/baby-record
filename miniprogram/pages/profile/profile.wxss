.hero-card--profile {
  background: linear-gradient(145deg, #fff8ef, #f3e2d4 58%, #e6c4a8 100%);
}

.profile-highlight {
  padding: 24rpx;
  color: #6d4c41;
  font-size: 28rpx;
  line-height: 1.6;
}

.context-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.context-grid .metric-card {
  min-width: 260rpx;
  flex: 1;
}

.profile-identity {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-identity__body {
  flex: 1;
  min-width: 0;
}

.profile-identity__name {
  font-size: 34rpx;
  font-weight: 700;
  color: #5d4037;
  line-height: 1.3;
}

.profile-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #f5e6d5;
  flex-shrink: 0;
}

.profile-avatar--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b4513;
  font-size: 42rpx;
  font-weight: 700;
  background: linear-gradient(180deg, #fff1dc, #efd1ae);
}
