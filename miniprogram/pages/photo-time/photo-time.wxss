.hero-card--timeline {
  background: linear-gradient(145deg, #fff8ef, #f5e6d6 58%, #e8c7a7 100%);
}

.timeline-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.timeline-card {
  background: linear-gradient(180deg, rgba(255, 253, 249, 0.97), rgba(255, 244, 230, 0.98));
  border: 2rpx solid rgba(229, 205, 178, 0.45);
}

.timeline-card__meta {
  flex: 1;
}

.timeline-card__header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.timeline-card__cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(139, 69, 19, 0.12);
}

.timeline-card__strip {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  white-space: nowrap;
}

.timeline-strip__inner {
  display: inline-flex;
  gap: 16rpx;
}

.timeline-photo {
  width: 180rpx;
}

.timeline-photo__image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 18rpx;
  background: #f5e3cb;
}

.timeline-photo__label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8d6e63;
}
