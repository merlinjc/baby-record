<view class="page">
  <ui-hero
    extra-class="hero-card--timeline"
    chip="时间回顾"
    accent="TIMELINE"
    kicker="按年、月、日切换查看，把成长记录沉淀成更稳定的检索路径。"
    title="按时间回看成长记录"
    subtitle="{{currentBaby ? currentBaby.name + ' 的照片支持按年、月、日分组查看，便于快速定位成长阶段。' : '先创建档案，再把照片自动沉淀到时间轴。'}}"
  >
    <view wx:if="{{!isLoading && groups.length}}" class="summary-grid mt-24">
      <summary-stat value="{{monthCount}}" label="当前分组数"></summary-stat>
      <summary-stat value="{{totalPhotos}}" label="累计照片"></summary-stat>
    </view>
  </ui-hero>

  <view class="filter-shell mt-24">
    <section-header title="时间筛选" caption="切换聚合粒度，优先满足快速定位和阶段回顾" chip="{{activeGroupBy === 'year' ? '按年' : activeGroupBy === 'month' ? '按月' : '按日'}}"></section-header>
    <view class="timeline-filter__tabs mt-24">
      <view wx:for="{{filterOptions}}" wx:key="value" class="timeline-filter__tab {{activeGroupBy === item.value ? 'timeline-filter__tab--active' : ''}}" data-value="{{item.value}}" bindtap="changeGroupBy">{{item.label}}</view>
    </view>
  </view>

  <block wx:if="{{isLoading}}">
    <status-card extra-class="mt-24" loading="{{true}}" title="正在生成时间轴" desc="按 {{activeGroupBy === 'year' ? '年份' : activeGroupBy === 'month' ? '月份' : '日期'}} 整理照片，需要一点时间。"></status-card>
  </block>

  <block wx:elif="{{loadError}}">
    <status-card extra-class="mt-24" title="时间轴暂时不可用" desc="{{loadError}}">
      <view class="status-card__actions">
        <button class="btn-secondary" bindtap="retryLoad">重新加载</button>
      </view>
    </status-card>
  </block>

  <block wx:elif="{{groups.length}}">
    <view class="timeline-list mt-24">
      <timeline-group-card wx:for="{{groups}}" wx:key="key" group="{{item}}" bind:phototap="openPhotoDetail"></timeline-group-card>
    </view>
  </block>

  <block wx:elif="{{!hasBaby}}">
    <empty-state-panel extra-class="mt-24" icon-name="badge-plus" title="还没有宝宝档案" desc="时间轴依赖当前档案，先创建一个宝宝档案，再开始沉淀照片记录。">
      <view class="status-inline">先建档，再上传照片</view>
      <button class="btn-primary mt-24" bindtap="goCreateBaby">创建档案</button>
    </empty-state-panel>
  </block>

  <block wx:else>
    <empty-state-panel extra-class="mt-24" icon-name="calendar-range" title="时间轴还是空的" desc="上传照片后，这里会自动按 {{activeGroupBy === 'year' ? '年份' : activeGroupBy === 'month' ? '月份' : '日期'}} 展示。">
      <view class="status-inline">先完成第一次上传</view>
      <button class="btn-primary mt-24" bindtap="goUpload">去上传照片</button>
    </empty-state-panel>
  </block>
</view>
