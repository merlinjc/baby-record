.hero-card--recycle {
  background: linear-gradient(145deg, #fff8ed, #f4eadc 55%, #ecd2ba 100%);
}

.recycle-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.recycle-card {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fffdf9, #fff4e6);
  box-shadow: 0 8rpx 24rpx rgba(139, 69, 19, 0.08);
}

.recycle-card__image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 18rpx;
  background: #f3e5d0;
}

.recycle-card__body {
  flex: 1;
}

.recycle-card__title {
  font-size: 30rpx;
  font-weight: 700;
}
