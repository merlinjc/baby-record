<view class="page">
  <view class="hero-card hero-card--recycle">
    <view class="hero-topline">
      <view class="chip">回收站</view>
      <view class="hero-accent">RECYCLE</view>
    </view>
    <view class="page-title mt-24">最近删除的照片</view>
    <view class="page-subtitle mt-16">删除后的照片会先进入回收站，可在这里恢复。</view>
  </view>

  <block wx:if="{{isLoading}}">
    <view class="section-card mt-24 status-card">
      <view class="loading-dots">
        <view class="loading-dots__item"></view>
        <view class="loading-dots__item"></view>
        <view class="loading-dots__item"></view>
      </view>
      <view class="status-card__title">正在读取回收站</view>
      <view class="status-card__desc">正在整理最近删除的照片。</view>
    </view>
  </block>

  <block wx:elif="{{loadError}}">
    <view class="section-card mt-24 status-card">
      <view class="status-card__title">回收站暂时不可用</view>
      <view class="status-card__desc">{{loadError}}</view>
      <view class="status-card__actions">
        <button class="btn-secondary" bindtap="retryLoad">重新加载</button>
      </view>
    </view>
  </block>

  <block wx:elif="{{photos.length}}">
    <view class="recycle-list mt-24">
      <view class="recycle-card" wx:for="{{photos}}" wx:key="_id">
        <image class="recycle-card__image" src="{{item.filePath}}" mode="aspectFill"></image>
        <view class="recycle-card__body">
          <view class="recycle-card__title">{{item.photoDate}}</view>
          <view class="section-caption mt-16">{{item.description || '未添加描述'}}</view>
          <button wx:if="{{item.canRestore}}" class="btn-secondary mt-24" data-id="{{item._id}}" bindtap="restorePhoto">恢复照片</button>
          <view wx:else class="section-caption mt-24">当前角色无恢复权限</view>
        </view>
      </view>
    </view>
  </block>
  <block wx:else>
    <view class="section-card mt-24 empty-state onboarding-card">
      <view class="empty-state__title">回收站是空的</view>
      <view class="empty-state__desc">删除的照片会先出现在这里，方便误删恢复。</view>
    </view>
  </block>
</view>
