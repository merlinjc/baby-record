.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 0 24rpx 24rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.tabbar-frame {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: rgba(255, 248, 235, 0.96);
  border: 2rpx solid rgba(215, 180, 138, 0.7);
  border-radius: 999rpx;
  box-shadow: 0 12rpx 36rpx rgba(139, 69, 19, 0.14);
  backdrop-filter: blur(10rpx);
  padding: 14rpx;
  pointer-events: auto;
}

.tabbar-item {
  position: relative;
  flex: 1;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #8d6e63;
  transition: all 0.2s ease;
}

.tabbar-item--active {
  background: linear-gradient(135deg, #f6e5cf, #fffaf3);
  color: #8b4513;
}

.tabbar-item__label {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

.tabbar-item__indicator {
  position: absolute;
  bottom: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 38rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #8b4513;
}
