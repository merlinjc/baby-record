.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 0 32rpx 28rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.safe-bottom {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.tabbar-frame {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: center;
  gap: 18rpx;
  background: rgba(255, 250, 242, 0.98);
  border: 2rpx solid rgba(223, 190, 156, 0.72);
  border-radius: 36rpx;
  box-shadow: 0 20rpx 44rpx rgba(139, 69, 19, 0.12);
  backdrop-filter: blur(14rpx);
  padding: 18rpx 20rpx;
  pointer-events: auto;
}
