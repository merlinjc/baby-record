.tabbar-item {
  position: relative;
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  color: #8d6e63;
  box-sizing: border-box;
}

.tabbar-item__content {
  width: 100%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 0 14rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.tabbar-item__icon {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}

.tabbar-item--active .tabbar-item__content {
  background: linear-gradient(135deg, #f6e5cf, #fffaf3);
  color: #8b4513;
  box-shadow: inset 0 0 0 2rpx rgba(237, 205, 171, 0.48);
}

.tabbar-item__label {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.tabbar-item__indicator {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #8b4513;
}
